# De Frisse Organisatie — omgevingsvariabelen
#
# Alle variabelen zijn optioneel: zonder configuratie werkt de scan volledig,
# alleen zonder opslag van resultaten.

# ── Supabase (opslag van sessiecode + gemiddelden per blad) ──────────────────
# Alleen de publieke anon-sleutel; die mag uitsluitend rijen toevoegen (zie
# supabase/schema.sql). Gebruik hier nooit de service-role-sleutel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_TABLE=scan_results

# ── Bewaartermijn ────────────────────────────────────────────────────────────
# Aantal maanden dat een scanresultaat bewaard blijft. De frontend zet op basis
# hiervan `expires_at`; de database ruimt verlopen rijen op. Vóór livegang
# bewust vaststellen (briefing §7). Maximum dat de database accepteert: 24.
VITE_RETENTION_MONTHS=12

# ── Inbedding ────────────────────────────────────────────────────────────────
# Leeg laten voor een eigen (sub)domein. Bij plaatsing onder een pad van een
# bestaande site: bijv. /frisse-organisatie/
VITE_BASE_PATH=
