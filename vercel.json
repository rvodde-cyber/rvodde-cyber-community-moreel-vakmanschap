{
  "redirects": [
    {
      "source": "/downloads/werkbladen/(.*)/WB-(MW\\d{2}|EX\\d{2})-HBO-HRM-(.*)",
      "destination": "/downloads/werkbladen/$1/WB-$2-HRM-$3",
      "permanent": true
    },
    {
      "source": "/downloads/werkbladen/(.*)/WB-GK(\\d{2})-HBO-(.*)",
      "destination": "/downloads/werkbladen/$1/WB-GK$2-$3",
      "permanent": true
    },
    {
      "source": "/images/werkbladen/WB-(MW\\d{2}|EX\\d{2})-HBO-HRM-(.*)",
      "destination": "/images/werkbladen/WB-$1-HRM-$2",
      "permanent": true
    },
    {
      "source": "/images/werkbladen/WB-GK(\\d{2})-HBO-(.*)",
      "destination": "/images/werkbladen/WB-GK$1-$2",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/wisselwerking",
      "destination": "/wisselwerking/index.html"
    },
    {
      "source": "/wisselwerking/((?!assets/).*)",
      "destination": "/wisselwerking/index.html"
    },
    {
      "source": "/frisse-organisatie",
      "destination": "/frisse-organisatie/index.html"
    },
    {
      "source": "/frisse-organisatie/((?!assets/).*)",
      "destination": "/frisse-organisatie/index.html"
    },
    {
      "source": "/((?!api/|downloads/|images/|wisselwerking|frisse-organisatie).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/wisselwerking/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/wisselwerking/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/frisse-organisatie/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/frisse-organisatie/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
